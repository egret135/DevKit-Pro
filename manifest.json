{
  "manifest_version": 3,
  "name": "DevKit Pro",
  "version": "2.0.4",
  "description": "An offline workbench that helps developers convert schemas, preview Markdown, and handle common coding tasks locally.",
  "action": {
    "default_title": "Open DevKit Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';"
  },
  "sandbox": {
    "pages": [
      "sandbox/mediainfo-sandbox.html"
    ]
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
